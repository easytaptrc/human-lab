rules_version = '2';

// Reglas de seguridad — Human Prime Lab
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------
    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isStaff() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.active == true;
    }
    function staffData() { return get(staffPath()).data; }
    function isOwner() { return isStaff() && staffData().role == 'owner'; }
    function can(p) {
      return isStaff() && (staffData().role == 'owner' || staffData().perms.get(p, false) == true);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // ---------- Configuración pública ----------
    match /settings/site {
      allow read: if true;
      allow write: if can('sitio');
    }
    match /settings/notify {
      allow read: if isStaff();
      allow write: if can('notificaciones');
    }
    match /media/{key} {
      allow read: if true;
      allow write: if can('sitio');
    }

    // Arranque: el primer usuario se convierte en dueño.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(staffPath()).data.role == 'owner';
      allow update, delete: if false;
    }

    // ---------- Personal ----------
    match /staff/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || can('personal');
      // Dueño inicial (sólo si todavía no existe meta/setup)
      allow create: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(/databases/$(database)/documents/meta/setup).data.ownerUid == uid
        && request.resource.data.role == 'owner';
      // Altas normales
      allow create: if can('personal') && request.resource.data.role == 'staff';
      allow update: if can('personal')
        && (resource.data.role != 'owner' || isOwner())
        && request.resource.data.role == resource.data.role;
      allow delete: if isOwner() && resource.data.role != 'owner';
    }

    // ---------- Servicios, horarios y cupos ----------
    match /services/{id} {
      allow read: if true;
      allow write: if can('servicios');
    }
    match /plans/{id} {
      allow read: if isStaff();
      allow write: if can('planes');
    }

    // Contador de lugares por servicio + fecha + hora (sin datos personales)
    match /slots/{slotId} {
      function svcCap(d) {
        return get(/databases/$(database)/documents/services/$(d.serviceId)).data.slots[string(d.dow) + '_' + d.time];
      }
      allow read: if true;
      allow create: if can('reservas') || (
        slotId == request.resource.data.serviceId + '__' + request.resource.data.date + '__' + request.resource.data.time
        && request.resource.data.keys().hasOnly(['serviceId', 'date', 'time', 'dow', 'cap', 'count'])
        && request.resource.data.count == 1
        && request.resource.data.cap == svcCap(request.resource.data)
      );
      allow update: if can('reservas') || (
        onlyChanges(['count', 'cap'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.cap == svcCap(resource.data)
        && request.resource.data.count <= request.resource.data.cap
      );
      allow delete: if can('reservas');
    }

    // ---------- Reservas ----------
    match /reservations/{id} {
      function slotPath(d) {
        return /databases/$(database)/documents/slots/$(d.serviceId + '__' + d.date + '__' + d.time);
      }
      function validPublic() {
        let d = request.resource.data;
        return d.keys().hasOnly(['serviceId', 'serviceName', 'date', 'time', 'dow', 'startAt', 'name', 'phone', 'email',
                                 'age', 'emergency', 'notes', 'memberId', 'memberIdTyped', 'status', 'attendance',
                                 'token', 'reminderSent', 'source', 'createdAt'])
          && d.status == 'confirmada' && d.attendance == 'pendiente' && d.reminderSent == false && d.source == 'web'
          && d.createdAt == request.time
          && d.startAt is timestamp && d.startAt > request.time
          && isStr(d.name, 3, 120) && isStr(d.phone, 10, 15) && isStr(d.email, 5, 160)
          && d.age is number && d.age >= 5 && d.age <= 110
          && isStr(d.emergency, 10, 15) && isStr(d.notes, 0, 600) && isStr(d.token, 16, 64)
          && isStr(d.memberId, 0, 20) && isStr(d.memberIdTyped, 0, 20)
          // El lugar debe descontarse en la misma transacción
          && getAfter(slotPath(d)).data.count ==
             (exists(slotPath(d)) ? get(slotPath(d)).data.count : 0) + 1;
      }
      allow create: if can('reservas') || validPublic();
      allow read: if can('reservas') || can('reportes') || can('notificaciones');
      allow update: if can('reservas')
        || (can('notificaciones') && onlyChanges(['reminderSent', 'reminderAt']))
        // Confirmación de asistencia desde el enlace del recordatorio
        || (onlyChanges(['attendance', 'attendanceAt', 'tokenCheck'])
            && request.resource.data.tokenCheck == resource.data.token
            && request.resource.data.attendance in ['confirmada', 'no_asistira']);
      allow delete: if isOwner();
    }

    // ---------- Socios ----------
    match /members/{id} {
      allow read: if can('socios') || can('reservas') || can('reportes') || can('mensajes') || can('notificaciones');
      allow create, delete: if can('socios');
      allow update: if can('socios')
        || ((can('reservas')) && onlyChanges(['lastVisit', 'visits']))
        || (can('notificaciones') && onlyChanges(['notifiedExpiry', 'promoSent']));
    }
    match /payments/{id} {
      allow read: if can('socios') || can('reportes');
      allow create: if can('socios');
      allow update, delete: if isOwner();
    }
    match /visits/{id} {
      allow read: if can('socios') || can('reportes');
      allow create: if can('socios') || can('reservas');
      allow update, delete: if isOwner();
    }

    // Panel del socio: la llave del documento es SHA-256(ID|últimos 4 del teléfono).
    match /portal/{key} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if can('socios');
      allow update: if can('socios')
        || ((can('mensajes') || can('notificaciones')) && onlyChanges(['inbox']))
        || (can('reservas') && onlyChanges(['lastVisit']));

      match /reservas/{rid} {
        allow read: if true;
        allow create: if can('reservas') || can('socios') || (
          exists(/databases/$(database)/documents/portal/$(key))
          && request.resource.data.keys().hasOnly(['serviceName', 'date', 'time', 'status', 'createdAt'])
          && request.resource.data.status == 'confirmada'
          && isStr(request.resource.data.serviceName, 1, 120)
        );
        allow update, delete: if can('reservas') || can('socios');
      }
    }

    // ---------- Comunicación ----------
    match /messages/{id} {
      allow read: if can('mensajes');
      allow create: if can('mensajes') || can('notificaciones') || can('socios');
      allow update, delete: if isOwner();
    }
    // Cola de correos para la extensión "Trigger Email" de Firebase
    match /mail/{id} {
      allow create: if can('mensajes') || can('notificaciones');
      allow read, update, delete: if isOwner();
    }
  }
}
